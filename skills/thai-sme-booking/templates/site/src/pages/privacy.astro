---
// PDPA privacy notice (template). Review with the shop owner before go-live — see references/pdpa.md.
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/data.js';

const { settings: s } = await getSite();
const months = s.retention_months || 12;
const contact = s.privacy_contact || s.phone || s.line_oa_id;
---
<Base title="นโยบายความเป็นส่วนตัว" description={`นโยบายความเป็นส่วนตัวของ ${s.shop_name}`}>
  <section class="section">
    <div class="wrap prose">
      <h1>นโยบายความเป็นส่วนตัว</h1>
      <p class="muted">{s.shop_name} ("ร้าน") ให้ความสำคัญกับข้อมูลส่วนบุคคลของลูกค้า ตามพระราชบัญญัติคุ้มครองข้อมูลส่วนบุคคล พ.ศ. 2562 (PDPA)</p>

      <h2>ข้อมูลที่เราเก็บ</h2>
      <ul>
        <li>ชื่อ และเบอร์โทรศัพท์ที่คุณกรอกเมื่อจองคิว</li>
        <li>รหัสผู้ใช้และชื่อที่แสดงใน LINE เมื่อคุณจองผ่าน LINE</li>
        <li>รายละเอียดการนัดหมาย (บริการ วัน เวลา สถานะ)</li>
        <li>ข้อมูลการชำระมัดจำจากสลิป (ยอดเงิน เวลา และเลขอ้างอิงรายการ) เพื่อยืนยันการชำระ</li>
      </ul>

      <h2>วัตถุประสงค์</h2>
      <p>เพื่อจัดการนัดหมาย ยืนยันการชำระมัดจำ ส่งข้อความเตือนนัด และติดต่อคุณเกี่ยวกับการใช้บริการ เราไม่ใช้ข้อมูลของคุณเพื่อการตลาดโดยไม่ได้รับความยินยอมเพิ่มเติม</p>

      <h2>ฐานทางกฎหมาย</h2>
      <p>การปฏิบัติตามสัญญาการให้บริการที่คุณร้องขอ และความยินยอมที่คุณให้ไว้ขณะจองคิว</p>

      <h2>การเปิดเผยข้อมูล</h2>
      <p>ข้อมูลถูกประมวลผลผ่านผู้ให้บริการที่ร้านใช้งานเพื่อให้ระบบทำงานได้ ได้แก่ LINE (ข้อความ), Google (จัดเก็บข้อมูลและปฏิทิน), Cloudflare (เว็บไซต์) และผู้ให้บริการตรวจสอบสลิป (ตรวจสอบรายการโอนกับธนาคาร) เราไม่ขายข้อมูลของคุณให้บุคคลอื่น</p>

      <h2>ระยะเวลาการเก็บรักษา</h2>
      <p>ข้อมูลที่ระบุตัวตนได้จะถูกลบหรือทำให้ไม่สามารถระบุตัวตนได้ภายใน {months} เดือนหลังวันนัดหมาย เว้นแต่กฎหมายกำหนดให้เก็บนานกว่านั้น</p>

      <h2>สิทธิของคุณ</h2>
      <p>คุณมีสิทธิขอเข้าถึง ขอสำเนา แก้ไข ลบ หรือระงับการใช้ข้อมูล ถอนความยินยอม และคัดค้านการประมวลผล รวมถึงร้องเรียนต่อสำนักงานคณะกรรมการคุ้มครองข้อมูลส่วนบุคคล (สคส.)</p>

      <h2>ติดต่อร้าน</h2>
      <p>{s.shop_name}{s.address && <> — {s.address}</>}<br />ช่องทางติดต่อเรื่องข้อมูลส่วนบุคคล: {contact}</p>
    </div>
  </section>
</Base>
